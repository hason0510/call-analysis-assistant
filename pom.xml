<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>io.hason</groupId>
  <artifactId>call-analysis-assistant</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>call-analysis-assistant</name>
  <description>AI Call Analysis Assistant - OJT AI 20K</description>

  <properties>
    <java.version>21</java.version>
    <testcontainers.version>1.20.1</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        Testcontainers 1.20.x kéo theo commons-compress 1.24.0, dính CVE-2024-25710
        và CVE-2024-26308. Chỉ ảnh hưởng scope test (dùng để đóng gói build-context
        cho Docker) nên rủi ro thực tế thấp, nhưng ghim bản đã vá cho sạch cảnh báo.
        Các bản testcontainers 1.x đều còn 1.24.0; chỉ 2.x mới lên 1.28.0.
      -->
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-compress</artifactId>
        <version>1.28.0</version>
      </dependency>
      <dependency>
        <groupId>me.paulschwarz</groupId>
        <artifactId>spring-dotenv-bom</artifactId>
        <version>5.1.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-elasticsearch</artifactId>
    </dependency>
    <!-- Chat API + Web UI (Sprint 2 T1, T2). Chỉ bật server khi chạy profile "web". -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>1.5.2</version>
    </dependency>
    <!--
      Nạp file .env (OPENAI_API_KEY…) vào Spring Environment khi chạy local. Bản springboot3-,
      KHÔNG phải springboot4-: bản 4 đăng ký bằng khoá org.springframework.boot.EnvironmentPostProcessor
      của Boot 4, Boot 3.5 không đọc khoá đó nên .env bị bỏ qua mà không báo lỗi gì.
    -->
    <dependency>
      <groupId>me.paulschwarz</groupId>
      <artifactId>springboot3-dotenv</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>elasticsearch</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!--
            spring-boot:run fork một JVM riêng. Từ JDK 18, stdout.encoding của JVM
            lấy theo bảng mã của console chứ không theo file.encoding, nên trên console
            Windows dùng bảng mã cũ thì chữ tiếng Việt bị thay bằng "?" ngay tại JVM,
            trước khi tới terminal. Ghim UTF-8 để output không phụ thuộc máy chạy.
          -->
          <jvmArguments>-Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</jvmArguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
