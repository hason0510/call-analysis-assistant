{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hason.io/call-analysis/report-v1.schema.json",
  "title": "Call Analysis Report v1",
  "description": "Cấu trúc report theo mẫu MVP mục 4.5. Sprint 2: AI chỉ được điền field theo schema này, không tự dựng bố cục.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "callId", "verdict", "qualityFlag", "confidenceLevel", "confidenceReasons", "summary",
    "evidence", "metrics", "possibleCauses", "suggestions", "dataLimitations", "degraded",
    "analysis", "analysisSource", "needsReview", "fallbackReason", "citedEvidenceIds", "aiSuggestions"
  ],

  "properties": {
    "callId": { "type": "string", "minLength": 1 },

    "verdict": { "enum": ["SUCCESS", "FAIL", "UNKNOWN"] },

    "qualityFlag": {
      "type": "boolean",
      "description": "SUCCESS vẫn có thể kèm cờ chất lượng kém (MVP mục 4.1)."
    },

    "issueCategory": {
      "oneOf": [
        { "type": "null" },
        {
          "enum": [
            "NETWORK_PACKET_LOSS", "NETWORK_DELAY_JITTER", "ICE_FAILURE",
            "TURN_FAILURE", "SIGNALING_FAILURE", "UNKNOWN"
          ]
        }
      ]
    },

    "confidenceLevel": {
      "enum": ["HIGH", "MEDIUM", "LOW"],
      "description": "Suy bằng logic tất định, không để AI sinh số (MVP mục 7.2)."
    },

    "confidenceReasons": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Vì sao ở mức confidenceLevel: yếu tố hạ mức trước, bằng chứng sau. Do ConfidencePolicy viết, không do AI."
    },

    "summary": { "type": "string", "minLength": 1 },

    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "timestamp", "description", "sourceRef"],
        "properties": {
          "id": { "type": "string", "pattern": "^EV[0-9]{2,}$" },
          "source": { "enum": ["SIGNALING", "ENDCALL", "WEBRTC"] },
          "timestamp": { "type": "string" },
          "description": { "type": "string", "minLength": 1 },
          "sourceRef": {
            "type": "string",
            "minLength": 1,
            "description": "Tên file kèm số dòng — MVP mục 8.2 yêu cầu trace về dòng log gốc."
          }
        }
      }
    },

    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": ["string", "null"] },
          "unit": { "type": ["string", "null"] },
          "naReason": { "type": ["string", "null"] },
          "source": { "enum": ["SIGNALING", "ENDCALL", "WEBRTC"] }
        },
        "oneOf": [
          {
            "description": "Có giá trị: value bắt buộc, naReason phải vắng.",
            "properties": {
              "value": { "type": "string", "minLength": 1 },
              "naReason": { "type": "null" }
            },
            "required": ["value"]
          },
          {
            "description": "Không có giá trị: BẮT BUỘC có lý do. MVP mục 4.3 cấm mặc định về 0.",
            "properties": {
              "value": { "type": "null" },
              "naReason": { "type": "string", "minLength": 1 }
            },
            "required": ["naReason"]
          }
        ]
      }
    },

    "possibleCauses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alternatives", "basisEvidenceIds"],
      "properties": {
        "primary": { "type": ["string", "null"] },
        "alternatives": { "type": "array", "items": { "type": "string" } },
        "reasoning": {
          "type": ["string", "null"],
          "description": "Vì sao kết luận vậy (MVP 7.1 T2) — lý do của rule, do code viết."
        },
        "basisEvidenceIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^EV[0-9]{2,}$" },
          "uniqueItems": true,
          "description": "Evidence là căn cứ của rule (MVP 7.1 T2: evidence nào hỗ trợ). Có cả khi không có AI."
        }
      }
    },

    "suggestions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Bộ đề xuất chuẩn theo issue category, do rule chọn (MVP 7.1 T2). AI bổ sung ở aiSuggestions."
    },

    "dataLimitations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Thiếu file, thiếu chỉ số, bản export bị cắt bớt (MVP mục 3.3)."
    },

    "degraded": {
      "type": "boolean",
      "description": "Sprint 2: đặt true khi phải lui về rule verdict do AI lỗi."
    },

    "analysis": {
      "type": ["string", "null"],
      "description": "Phần phân tích của AI, ưu tiên trọng tâm câu hỏi. null khi report dựng từ rule."
    },

    "analysisSource": {
      "enum": ["AI", "RULE"],
      "description": "AI: kết luận đi qua AI + Guardrails. RULE: chỉ rule (CLI Sprint 1 hoặc fallback)."
    },

    "needsReview": {
      "type": "boolean",
      "description": "AI lệch rule (Guardrails G04) — gắn cờ cần kiểm tra (MVP mục 3.2)."
    },

    "fallbackReason": {
      "type": ["string", "null"],
      "pattern": "^[A-Z_]+$",
      "description": "Mã lý do lùi về rule, không phải văn bản tự do. null khi không degraded."
    },

    "citedEvidenceIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^EV[0-9]{2,}$" },
      "uniqueItems": true,
      "description": "Evidence AI dùng làm căn cứ cho phần phân tích (MVP mục 3.3). Rỗng khi report dựng từ rule."
    },

    "aiSuggestions": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1 },
      "description": "Đề xuất AI bổ sung cho bộ đề xuất chuẩn ở suggestions (MVP 7.1 T2). Rỗng khi report dựng từ rule."
    }
  },

  "allOf": [
    {
      "description": "Report từ rule không có phần phân tích của AI.",
      "if": { "properties": { "analysisSource": { "const": "RULE" } } },
      "then": { "properties": { "analysis": { "type": "null" }, "citedEvidenceIds": { "maxItems": 0 },
                                "aiSuggestions": { "maxItems": 0 } } }
    },
    {
      "description": "degraded khi và chỉ khi có lý do fallback.",
      "if": { "properties": { "degraded": { "const": true } } },
      "then": { "properties": { "fallbackReason": { "type": "string" }, "analysisSource": { "const": "RULE" } } },
      "else": { "properties": { "fallbackReason": { "type": "null" } } }
    }
  ]
}
